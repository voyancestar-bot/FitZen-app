# Copie ce fichier en ".env" (à la racine du projet) et remplis les valeurs.
# Ne commite jamais le fichier ".env" réel dans git (il contient des clés secrètes).

# --- Stripe (paiement réel) ---
# Récupère ces clés sur https://dashboard.stripe.com/test/apikeys (mode Test pour commencer)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Crée 2 produits "récurrents" dans https://dashboard.stripe.com/test/products
# (un prix mensuel ~9.99€, un prix annuel ~79.99€) et colle leurs Price ID ici :
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...

# Optionnel : signature de webhook (https://dashboard.stripe.com/test/webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Pexels (vraies vidéos fitness libres de droits) ---
# Clé gratuite sur https://www.pexels.com/api/
PEXELS_API_KEY=...

# --- Resend (email de bienvenue à l'abonnement) ---
# Clé gratuite sur https://resend.com/api-keys
RESEND_API_KEY=re_...
# Sans domaine vérifié sur Resend, laisse cette valeur par défaut (limité à ton
# propre email de compte Resend). Avec un domaine vérifié : "FitZen <contact@tondomaine.com>"
RESEND_FROM_EMAIL=FitZen <onboarding@resend.dev>

# URL publique de l'app (utilisée pour les redirections Stripe après paiement)
APP_BASE_URL=http://localhost:8420

# --- Comptes utilisateurs (mot de passe + connexion Google) ---
# Clé de session Flask : génère une valeur aléatoire longue, par ex. avec
# `python3 -c "import secrets; print(secrets.token_hex(32))"`
# Sans cette clé, une clé temporaire est générée à chaque démarrage (les
# connexions sont alors invalidées à chaque redémarrage du serveur).
FLASK_SECRET_KEY=

# Client ID OAuth (PAS le secret) depuis https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
